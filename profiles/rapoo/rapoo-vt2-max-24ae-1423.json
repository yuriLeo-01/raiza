{
  "$schema": "../schema.json",
  "schema": 1,
  "name": "Rapoo VT2 Max / VT2 Pro Max",
  "vendor": "Rapoo",
  "kind": "mouse",
  "verified": true,
  "authors": [
    "Raiza (a partir do protocolo documentado pelo projeto periph, MIT)"
  ],
  "match": [
    {
      "vendor_id": "24ae",
      "product_id": "1423",
      "interface": 1,
      "connection": "wireless"
    },
    {
      "vendor_id": "24ae",
      "product_id": "4623",
      "interface": 1,
      "connection": "wired"
    }
  ],
  "capabilities": {
    "dpi": {
      "min": 50,
      "max": 26000,
      "step": 10,
      "read": {
        "response": {
          "type": "input",
          "report_id": 7,
          "length": 18,
          "fields": {
            "value": {
              "at": 2,
              "encoding": "u16le"
            }
          }
        }
      }
    },
    "polling_rate": {
      "rates": {
        "125": 8,
        "250": 4,
        "500": 2,
        "1000": 1,
        "2000": 132,
        "4000": 130,
        "8000": 129
      },
      "read": {
        "response": {
          "type": "input",
          "report_id": 7,
          "length": 18,
          "fields": {
            "value": {
              "at": 10
            }
          }
        }
      },
      "write": {
        "type": "output",
        "report_id": 6,
        "data": "a5 a5 01 80 08 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
        "fields": {
          "value": {
            "at": 7
          }
        }
      }
    },
    "battery": {
      "read": {
        "response": {
          "type": "input",
          "report_id": 7,
          "length": 18,
          "fields": {
            "percent": {
              "at": 7
            },
            "charging": {
              "at": 6,
              "mask": 2
            }
          }
        }
      }
    }
  }
}
