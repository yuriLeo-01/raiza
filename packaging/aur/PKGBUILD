# Maintainer: Yuri França <yurileo2005 at gmail dot com>
pkgname=raiza-git
pkgver=0.0.1.r0.g0000000
pkgrel=1
pkgdesc='Hub único para gerenciar periféricos no Linux, de qualquer marca (daemon, CLI e app GTK4)'
arch=('x86_64' 'aarch64')
url='https://github.com/yuriLeo-01/raiza'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'systemd-libs' 'dbus')
makedepends=('cargo' 'git')
optdepends=(
  'pipewire: volume e mudo (usa pw-dump)'
  'wireplumber: volume e mudo (usa wpctl)'
  'bluez: dispositivos Bluetooth'
  'upower: nível de bateria'
  'gnome-shell: bateria dos periféricos no painel (extensão)'
)
provides=('raiza')
conflicts=('raiza')
install=raiza-git.install
source=("${pkgname}::git+https://github.com/yuriLeo-01/raiza.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local version
  version=$(grep -m1 '^version' Cargo.toml | sed 's/.*"\(.*\)"/\1/')
  printf '%s.r%s.g%s' "$version" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p raizad -p raiza-ctl -p raiza-gtk -p raiza-tray

  # Completions geradas pelo próprio binário, sempre em inglês (msgids), mesmo que a
  # máquina de build esteja em outra língua e já tenha o Raiza instalado.
  mkdir -p completions
  local shell
  for shell in bash zsh fish; do
    LANGUAGE= LC_ALL=C target/release/raiza-ctl completions "$shell" > "completions/$shell"
  done

  # Tradução do app, da bandeja, do CLI e dos avisos (domínio raiza, po/LINGUAS).
  po/compilar.sh locale

  # Tradução da extensão do GNOME Shell (o msgfmt vem no gettext, do base-devel).
  local po
  for po in extensions/gnome/po/*.po; do
    mkdir -p "extensions/gnome/locale/$(basename "$po" .po)/LC_MESSAGES"
    msgfmt -o "extensions/gnome/locale/$(basename "$po" .po)/LC_MESSAGES/raiza-shell-extension.mo" "$po"
  done
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm755 -t "$pkgdir/usr/bin" \
    target/release/raizad target/release/raiza-ctl target/release/raiza-gtk \
    target/release/raiza-tray

  install -Dm644 packaging/udev/70-raiza.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-raiza.rules"
  install -Dm644 packaging/systemd/raizad.service \
    "$pkgdir/usr/lib/systemd/user/raizad.service"
  install -Dm644 packaging/systemd/io.github.yurileo01.Raiza.Daemon.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.yurileo01.Raiza.Daemon.service"

  install -Dm644 data/io.github.yurileo01.Raiza.desktop \
    "$pkgdir/usr/share/applications/io.github.yurileo01.Raiza.desktop"
  install -Dm644 data/io.github.yurileo01.Raiza.Tray.desktop \
    "$pkgdir/etc/xdg/autostart/io.github.yurileo01.Raiza.Tray.desktop"
  install -Dm644 data/io.github.yurileo01.Raiza.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.yurileo01.Raiza.metainfo.xml"

  local icon
  while IFS= read -r -d '' icon; do
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${icon#data/icons/hicolor/}"
  done < <(find data/icons/hicolor -type f -print0)

  local profile
  while IFS= read -r -d '' profile; do
    install -Dm644 "$profile" "$pkgdir/usr/share/raiza/${profile}"
  done < <(find profiles -type f -print0)

  local ext="$pkgdir/usr/share/gnome-shell/extensions/raiza@yurileo01.github.io"
  install -Dm644 -t "$ext" extensions/gnome/metadata.json extensions/gnome/extension.js
  local mo
  while IFS= read -r -d '' mo; do
    install -Dm644 "$mo" "$ext/${mo#extensions/gnome/}"
  done < <(find extensions/gnome/locale -name '*.mo' -print0)

  local catalog
  while IFS= read -r -d '' catalog; do
    install -Dm644 "$catalog" "$pkgdir/usr/share/${catalog}"
  done < <(find locale -name 'raiza.mo' -print0)

  install -Dm644 completions/bash \
    "$pkgdir/usr/share/bash-completion/completions/raiza-ctl"
  install -Dm644 completions/zsh \
    "$pkgdir/usr/share/zsh/site-functions/_raiza-ctl"
  install -Dm644 completions/fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/raiza-ctl.fish"
}
