msgid "Color as #rrggbb"
msgstr "Cor no formato #rrggbb"

#: crates/raiza-ctl/src/cli.rs:261
msgid "Send a rumble pulse"
msgstr "Dispara um pulso de vibração"

#: crates/raiza-ctl/src/cli.rs:262
msgid "Strength from 0 to 100"
msgstr "Intensidade de 0 a 100"

#: crates/raiza-ctl/src/cli.rs:263
msgid "Duration in milliseconds"
msgstr "Duração em milissegundos"

